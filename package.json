{
  "name": "vocabulary-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate:local && vite build && wrangler dev",
    "dev:ui": "vite",
    "build": "vite build",
    "deploy": "vite build && wrangler d1 migrations apply vocabulary-app --remote && wrangler deploy",
    "test": "vite build && vitest run --project unit --project worker",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply vocabulary-app --local",
    "db:migration": "wrangler d1 migrations create vocabulary-app",
    "db:fixture:local": "node scripts/fixture-seed.ts > .wrangler/fixture-seed.sql && wrangler d1 execute vocabulary-app --local --file .wrangler/fixture-seed.sql",
    "eval:grader": "vitest run --project grader-eval",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.8",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.153.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true,
    "fsevents": false
  }
}
