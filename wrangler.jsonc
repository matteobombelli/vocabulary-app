{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vocabulary-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  // The Anthropic SDK needs node:* built-ins.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "vocab.matteob.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vocabulary-app",
      "database_id": "8206fd20-e698-4371-bb73-cfb367e25ac9",
      "migrations_dir": "migrations"
    }
  ],
  // Secrets (wrangler secret put): REGISTRATION_SECRET, ANTHROPIC_API_KEY.
  // GRADER_MODE "stub" swaps the Claude grader for a local heuristic (tests, e2e).
  "vars": {
    "MONTHLY_BUDGET_USD": "5",
    "DAILY_GRADED_CAP": "200",
    "GRADER_MODE": "claude"
  },
  "observability": { "enabled": true }
}
